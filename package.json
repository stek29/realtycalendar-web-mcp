{
  "name": "realtycalendar-web-mcp",
  "version": "0.3.0",
  "description": "MCP server for RealtyCalendar, built on its web app API",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "realtycalendar-web-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run test/unit",
    "tools": "tsx scripts/dump-tools.ts",
    "test:live": "vitest run test/live --silent=false",
    "evals": "tsx test/evals/run.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/server": "^2.3.1",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
